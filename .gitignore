# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Build artifacts
build/
dist/
*.whl

# Research runtime (keep summaries under research/runs/protocol_v0 if small)
research/literature/_drafts/
research/_drafts/

# Runtime workspace artifacts (run outputs stay out of git, keep the skeleton)
workspace/runs/*
!workspace/runs/.gitkeep
workspace/input/raw/*
!workspace/input/raw/.gitkeep
workspace/input/context/*
!workspace/input/context/.gitkeep
workspace/input/expressions/*
!workspace/input/expressions/.gitkeep
*.tmp

# Editor / OS noise
.idea/
.vscode/
.codex/
.claude/
.qoder/
.DS_Store

.env
.env.*
