# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Build artifacts
build/
dist/
*.whl

# Runtime workspace artifacts (run outputs stay out of git, keep the skeleton)
workspace/runs/*
!workspace/runs/.gitkeep
*.tmp

