{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ssc-representation-bench-v0.1",
  "title": "ssc-representation-bench-v0.1 task",
  "$comment": "On-disk record. proposer_view() copies only public fields.",
  "type": "object",
  "required": [
    "id",
    "version",
    "split",
    "tier",
    "family",
    "task",
    "current",
    "source_expressions",
    "symbols",
    "functions",
    "assumptions",
    "catalog",
    "source_format",
    "scientific_context",
    "hidden_from_proposer",
    "target_type",
    "instance_maps",
    "r_level",
    "polarity",
    "negative_tempting_structures",
    "provenance_hidden",
    "difficulty"
  ],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string", "const": "ssc-representation-bench-v0.1" },
    "split": { "enum": ["dev", "test"] },
    "tier": { "enum": ["A", "B", "C"] },
    "family": { "type": "string" },
    "domain": { "type": "string" },
    "task": { "const": "representation_invention" },
    "current": { "type": "string" },
    "source_expressions": { "type": "array", "items": { "type": "string" } },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "real": { "type": "boolean" },
          "nonzero": { "type": "boolean" }
        }
      }
    },
    "functions": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^G\\d{4}$" },
          "text": { "type": "string" },
          "kind": { "type": "string" }
        }
      }
    },
    "catalog_external": { "type": "boolean" },
    "source_format": { "enum": ["sympy"] },
    "scientific_context": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" },
    "hidden_from_proposer": { "type": "boolean", "const": true },
    "target_type": {
      "type": ["string", "null"],
      "enum": [
        "local_confluence",
        "divided_difference",
        "hermite_divided_difference",
        "derivative_family",
        "recurrence_family",
        "master_function",
        "generating_function",
        "invariant_basis",
        "tensor_generator",
        "other_explicit",
        null
      ]
    },
    "hidden_target_type": { "type": ["string", "null"] },
    "gold_types": { "type": "array", "items": { "type": "string" } },
    "instance_maps": { "type": "object" },
    "hidden_instance_maps": { "type": "object" },
    "r_level": {
      "type": ["string", "null"],
      "enum": ["R0", "R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", null]
    },
    "hidden_r_level": { "type": ["string", "null"] },
    "polarity": { "enum": ["positive", "negative"] },
    "negative_tempting_structures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance_hidden": { "type": "string" },
    "provenance": { "type": "string" },
    "expected_verdict": {
      "type": ["string", "null"],
      "enum": ["ZERO", "NONZERO", "UNKNOWN", "ABSTAIN", null]
    },
    "notes": { "type": "string" },
    "ladder_id": { "type": ["string", "null"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "hidden_gold": { "type": "object" }
  }
}
