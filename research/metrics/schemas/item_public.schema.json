{
  "$comment": "Proposer-visible projection. Hidden keys must be absent.",
  "type": "object",
  "required": ["id", "tier", "family", "task", "current", "symbols"],
  "properties": {
    "id": { "type": "string" },
    "tier": { "type": "string" },
    "family": { "type": "string" },
    "task": { "type": "string" },
    "current": { "type": "string" },
    "symbols": { "type": "array" },
    "functions": { "type": "array" },
    "source_format": { "type": "string" },
    "structure_summary": { "type": "object" }
  },
  "not": {
    "anyOf": [
      { "required": ["human_reference"] },
      { "required": ["target_compact"] },
      { "required": ["expected_verdict"] }
    ]
  }
}
