    given-names: Kawa
repository-code: "https://github.com/DarrenWongKaWa/symbolic-compactification"
url: "https://github.com/DarrenWongKaWa/symbolic-compactification"
license: MIT
version: 0.3.2-alpha
keywords:
  - symbolic computation
  - theoretical physics
  - verification
  - SymPy
  - language models
