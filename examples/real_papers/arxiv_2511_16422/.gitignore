# Do not commit the copyrighted PDF or arXiv tarball.
*.pdf
eprint.bin
html.html
# Tool-owned run snapshots are regenerated by reproduce.sh / ssc audit verify.
runs/*
!runs/.gitkeep
reviewer-verification-package/replay/runs/*
!reviewer-verification-package/replay/runs/.gitkeep
reviewer-verification-package/replay/reports/*
!reviewer-verification-package/replay/reports/.gitkeep
